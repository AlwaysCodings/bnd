# ============================================================
# ADU OTAK BERDUA — Environment Variables
# ============================================================

# Supabase Project URL & Keys (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side ONLY, untuk evaluasi jawaban aman)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base URL aplikasi (untuk share link room)
NEXT_PUBLIC_APP_URL=http://localhost:3000
